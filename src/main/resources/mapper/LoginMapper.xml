<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.example.tsevaluationsystem.common.login.mapper.LoginMapper">

    <select id="selectUserLogin" resultType="org.example.tsevaluationsystem.dto.UserInfo">
        SELECT * from tb_user_info where user_id = #{userId} and password = #{password}
    </select>
</mapper>